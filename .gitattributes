# Normalize line endings to LF in the repository; checkout as native on Windows
* text=auto eol=lf

# Explicit binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdb binary
*.pdbqt binary
*.sdf binary
*.mol binary
*.mol2 binary
*.xlsx binary
*.pyc binary

# Force LF for source/config files
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.po text eol=lf
*.bat text eol=crlf
