# =============================================================================
# RePo-SUDOE-AI — Variables de entorno
# =============================================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el archivo .env al control de versiones.
# cp .env.example .env
# =============================================================================


# =============================================================================
# Django — Configuración general
# =============================================================================

# Clave secreta de Django. DEBE ser única y larga en producción.
# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-change-this-in-production

# Modo debug. True solo en desarrollo. En producción: False
DEBUG=True

# Hosts permitidos, separados por comas.
# En desarrollo: localhost,127.0.0.1
# En producción: tu-dominio.com,www.tu-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Zona horaria
TIME_ZONE=Europe/Madrid

# Idioma por defecto
LANGUAGE_CODE=es


# =============================================================================
# Base de datos — PostgreSQL
# =============================================================================

# Motor de base de datos
DB_ENGINE=django.db.backends.postgresql

# Nombre de la base de datos
DB_NAME=repo_sudoe_ai

# Usuario de PostgreSQL
DB_USER=admin

# Contraseña de PostgreSQL
DB_PASSWORD=changeme_in_production

# Host de PostgreSQL
# En Docker Compose: usar el nombre del servicio (db)
# En local: localhost
DB_HOST=db

# Puerto de PostgreSQL
DB_PORT=5432


# =============================================================================
# Proveedores de IA — API Keys
# =============================================================================
# Solo necesitas la key del proveedor que vayas a usar.
# Si usas Ollama (local), no necesitas ninguna key externa.

# --- OpenAI ---
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo de OpenAI a usar por defecto
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Anthropic a usar por defecto
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Google Gemini ---
# Obtén tu key en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Modelo de Google a usar por defecto
GOOGLE_MODEL=gemini-1.5-flash

# --- Ollama (IA local, sin key, sin coste) ---
# URL del servidor Ollama.
# En Docker Compose: http://ollama:11434
# En local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama a usar por defecto (debe estar descargado previamente)
# Para descargar: docker exec repo-sudoe-ollama ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b


# =============================================================================
# Cifrado de campos en base de datos (django-cryptography)
# =============================================================================
# Clave de cifrado para las API keys de usuarios almacenadas en BD.
# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ADVERTENCIA: Si cambias esta clave, los datos cifrados existentes quedarán ilegibles.
FIELD_ENCRYPTION_KEY=your-encryption-key-change-this


# =============================================================================
# AutoDock Vina — Configuración Docker
# =============================================================================

# Imagen Docker de AutoDock Vina
# Imagen usada por el proyecto (creada por Carlos Fernández-Lozano, UDC):
VINA_DOCKER_IMAGE=cafernandezlo/dock-tools:v1.0

# Número máximo de jobs de docking que pueden ejecutarse simultáneamente
VINA_MAX_PARALLEL_JOBS=2

# Límite de CPU por contenedor de docking (100000 = 1 CPU completo)
VINA_CPU_QUOTA=100000

# Límite de memoria RAM por contenedor de docking
VINA_MEM_LIMIT=512m

# Timeout máximo por job de docking en segundos (1200 = 20 minutos)
VINA_TIMEOUT_SECONDS=1200

# Directorio base para archivos temporales de jobs en el host
VINA_JOBS_DIR=/tmp/vina_jobs

# Directorio de archivos de entrada (receptores y ligandos)
VINA_INPUT_DIR=/app/input

# Directorio de archivos de salida (resultados)
VINA_OUTPUT_DIR=/app/output


# =============================================================================
# Redis — Broker para Celery y Django Channels (Fase 2 y 4)
# =============================================================================

# URL de Redis para Celery (broker de mensajes y backend de resultados)
REDIS_URL=redis://redis:6379/0

# URL de Redis para Django Channels (WebSockets)
REDIS_CHANNELS_URL=redis://redis:6379/1


# =============================================================================
# Servidor web
# =============================================================================

# Puerto en el que escucha la aplicación web
WEB_PORT=8000

# Número de workers de Gunicorn (producción sin WebSockets)
GUNICORN_WORKERS=2

# Número de workers de Celery
CELERY_CONCURRENCY=2


# =============================================================================
# Seguridad (habilitar en producción con SSL/HTTPS)
# =============================================================================

# Forzar HTTPS. En desarrollo: False. En producción: True
SECURE_SSL_REDIRECT=False

# Cookie segura para CSRF. En producción: True
CSRF_COOKIE_SECURE=False

# Cookie segura para sesiones. En producción: True
SESSION_COOKIE_SECURE=False

# Origins permitidos para CSRF (necesario si frontend y backend están en dominios distintos)
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com


# =============================================================================
# Email — para notificaciones y recuperación de contraseña
# =============================================================================

# Backend de email.
# Desarrollo (imprime en stdout): django.core.mail.backends.console.EmailBackend
# Producción (SMTP real):         django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=RePo-SUDOE-AI <noreply@repo-sudoe-ai.com>
